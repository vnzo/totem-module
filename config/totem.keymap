//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    flavor = "tap-preferred";
    quick-tap-ms = <200>;
};

&sk { release-after-ms = <600000>; };

&mt {
    tapping-term-ms = <170>;
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* TAP-DANCE: 1 tap = Tab, 2 taps = Caps Lock */
        /* MOD-MORPH: Backspace that becomes Delete when Shift is held */
        /* This solves your Shift+Tab worry—you can keep Shift+Tab functional! */

        bs_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* HOLD-TAP (Layer/Repeat): Tap = BSPC, Hold = Layer 2 */
        /* This includes 'quick-tap-ms' to allow the repeat-on-hold you like! */

        lt_repeat: layer_tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>; // This enables the "double-tap-and-hold to repeat"
            bindings = <&mo>, <&kp>;
        };

        /* MOD-MORPH: Dot on tap, Colon on Shift+Dot */

        shift_backspace: shift_backspace-space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp SPACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_forward_next: td_forward_next {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LS(LA(LC(F8)))>, <&kp C_NEXT>;

            label = "TD_FORWARD_NEXT";
        };

        td_backward_prev: td_backward_prev {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LS(LA(LC(F7)))>, <&kp C_PREVIOUS>;

            label = "TD_BACKWARD_PREV";

            /* 1. The Tap-Dance (The Actions) */

            td_explorer_pp: td_explorer_pp {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <300>;
                bindings = <&kp LG(E)>, <&kp C_PLAY_PAUSE>;
            };

            /* 2. The Hold-Tap (The Logic) */

            rwin_explorer_pp: rwin_explorer_pp {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred";
                tapping-term-ms = <200>;
                bindings = <&kp>, <&td_explorer_pp>;
            };

            /* 1. The Mod-Morph (Normal = Backspace, Shift = Space) */

            bs_spc: backspace_space {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp BSPC>, <&kp SPACE>;

                mods = <(MOD_LSFT|MOD_RSFT)>;
            };

            /* 2. The Layer-Tap Wrapper (Hold = Layer, Tap = The Mod-Morph) */

            lt_bs_spc: layer_tap_bs_spc {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred";
                tapping-term-ms = <200>;
                bindings = <&mo>, <&bs_spc>;

                /* Hold switches layer, Tap triggers the Morph */

                quick-tap-ms = <200>;
            };

            /* 1. The Tap-Dance (Tuned for fast double-taps) */

            td_tab_back: td_tab_back {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <200>; // Fast window for the double-tap
                bindings = <&kp TAB>, <&kp C_AC_BACK>;
            };

            /* 2. The Hold-Tap (Tuned for slow navigation) */

            lalt_tab_back: lalt_tab_back {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred"; // Prioritizes the Tab/Dance over the Layer
                tapping-term-ms = <250>;   // Must hold for 250ms to trigger Layer 1
                quick-tap-ms = <200>;      // Allows slow-but-repeated Tabbing
                bindings = <&mo>, <&td_tab_back>;
            };

            ralt_del_home_forward_mouse: ralt_del_home_forward_mouse {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred";
                tapping-term-ms = <250>;
                quick-tap-ms = <200>;
                bindings = <&mo>, <&td_home_end_mouse>;

                label = "RALT_DEL_HOME_FORWARD_MOUSE";
            };

            td_home_end_mouse: td_home_end_mouse {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <200>;
                bindings = <&kp HOME>, <&kp C_AC_FORWARD>;

                label = "TD_HOME_END_MOUSE";
            };
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };

        email: my_period_macro {
            compatible = "zmk,behavior-macro";
            label = "MY_PERIOD_MACRO";
            #binding-cells = <0>;
            bindings = <&kp V &kp N &kp Z &kp AT &kp L &kp I &kp V &kp E &kp DOT &kp C &kp O &kp M>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            timeout-ms = <50>;
            key-positions = <22 23>; // This assumes position 2 and 3 on your keyboard. Adjust as needed.
            bindings = <&kp ESCAPE>;
            layers = <0>; // This combo will only work on layer 0.
        };

        del {
            timeout-ms = <100>;
            key-positions = <23 24>;
            bindings = <&kp DEL>;
        };

        tab {
            timeout-ms = <40>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
        };

        todo2 {
            timeout-ms = <100>;
            bindings = <&kp END>;
            key-positions = <7 8>;
        };

        home {
            timeout-ms = <120>;
            bindings = <&kp HOME>;
            key-positions = <21 11>;
        };

        pageup2 {
            timeout-ms = <120>;
            bindings = <&kp PAGE_UP>;
            key-positions = <12 22>;
        };

        end {
            timeout-ms = <120>;
            bindings = <&kp END>;
            key-positions = <18 30>;
        };

        pagedn2 {
            timeout-ms = <120>;
            bindings = <&kp PAGE_DOWN>;
            key-positions = <17 29>;
        };

        vul-up {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 15>;
            timeout-ms = <100>;
        };

        vul-dn {
            bindings = <&kp C_VOLUME_DOWN>;
            key-positions = <26 15>;
            timeout-ms = <100>;
        };

        todo6 {
            bindings = <&kp GREATER_THAN>;
            key-positions = <14 25>;
            timeout-ms = <100>;
        };

        space3 {
            bindings = <&kp SPACE>;
            key-positions = <13 24>;
            timeout-ms = <100>;
        };

        pageup {
            bindings = <&kp PAGE_UP>;
            key-positions = <8 18>;
            timeout-ms = <100>;
        };

        pagedn {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <18 29>;
            timeout-ms = <100>;
        };

        shift-input {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <27 28>;
        };

        todo7 {
            bindings = <&email>;
            key-positions = <21 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        L0-base {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "L0-base";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     H     ┃     O     ┃     U     ┃     ?     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     Y     ┃     I     ┃     E     ┃     A     ┃     .     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     WIN   ┃     J     ┃     X     ┃     ,     ┃     K     ┃     '     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    ALT    ┃    BKSP   ┃   ENTER   ┃   ┃   SPACE   ┃    DEL    ┃    ALT    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                     &kp Q  &kp H        &kp O               &hm LEFT_WIN U  &lt 8 QUESTION    &lt 9 G      &hm RIGHT_WIN C  &kp R                             &kp F        &kp Z
                     &kp Y  &kp I        &kp E               &hm LSHFT A     &lt 7 PERIOD      &kp D        &hm RSHFT T      &kp S                             &kp N        &kp B
&mt LEFT_WIN ESCAPE  &kp J  &hm LCTRL X  &hm LEFT_ALT COMMA  &kp K           &kp SQT           &kp W        &kp M            &hm RIGHT_ALT L                   &hm RCTRL P  &kp V  &rwin_explorer_pp RIGHT_WIN 0
                                         &lalt_tab_back 1 0  &lt_bs_spc 2 0  &lt 3 ENTER       &lt 4 SPACE  &lt 5 DELETE     &ralt_del_home_forward_mouse 6 0
            >;
        };

        L1-cs {
            label = "L1-cs";
            bindings = <
                      &kp LC(LS(Q))  &kp LC(LS(H))  &kp LC(LS(O))      &kp LC(LS(U))         &kp LC(LS(QUESTION))    &kp LC(LS(G))         &kp LC(LS(C))         &kp LC(LS(R))         &kp LC(LS(F))  &kp LC(LS(Z))
                      &kp LC(LS(Y))  &kp LC(LS(I))  &kp LC(LS(E))      &kp LC(LS(A))         &kp LC(LS(DOT))         &kp LC(LS(D))         &kp LC(LS(T))         &kp LC(LS(S))         &kp LC(LS(N))  &kp LC(LS(B))
&kp LC(LS(NUMBER_1))  &kp LC(LS(J))  &kp LC(LS(X))  &kp LC(LS(COMMA))  &kp LC(LS(K))         &kp LC(LS(SQT))         &kp LC(LS(W))         &kp LC(LS(M))         &kp LC(LS(L))         &kp LC(LS(P))  &kp LC(LS(V))  &kp LC(LS(NUMBER_7))
                                                    &trans             &kp LC(LS(NUMBER_2))  &kp LC(LS(NUMBER_3))    &kp LC(LS(NUMBER_4))  &kp LC(LS(NUMBER_5))  &kp LC(LS(NUMBER_6))
            >;
        };

        L2-edit {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "L2-edit";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃     UP    ┃           ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃   P UP    ┃  C LOCK   ┃  P DOWN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃    DEL    ┃     0     ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
          &kp LC(LG(T))  &kp LC(C)        &kp UP_ARROW        &hm LEFT_WIN LA(LC(Z))  &kp LA(LS(Q))       &kp KP_MULTIPLY  &hm RIGHT_WIN NUMBER_7    &kp NUMBER_8            &kp NUMBER_9        &kp PLUS
          &kp LA(F4)     &kp LEFT         &kp DOWN            &kp RIGHT               &kp LC(F)           &kp KP_DIVIDE    &hm RIGHT_SHIFT NUMBER_4  &kp NUMBER_5            &kp NUMBER_6        &kp MINUS
&kp HOME  &kp INS        &hm LCTRL LC(X)  &hm LEFT_ALT LC(Z)  &kp LC(V)               &kp LS(INS)         &kp PERIOD       &kp NUMBER_1              &hm RIGHT_ALT NUMBER_2  &hm RCTRL NUMBER_3  &kp PAUSE_BREAK  &kp C_AL_CALCULATOR
                                          &td_backward_prev   &none                   &td_forward_next    &kp EQUAL        &kp NUMBER_0              &kp LS(LA(LC(PERIOD)))
            >;
        };

        L3-navi {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "L3 navi";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     @     ┃     #     ┃     $     ┃     %     ┃   ┃     ˆ     ┃     &     ┃     Ü     ┃     '     ┃     "     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     Ä     ┃           ┃    SZ     ┃           ┃           ┃   ┃   MUTE    ┃   YEN     ┃   EURO    ┃  POUND    ┃     Ö     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃  EMAIL1   ┃  EMAIL2   ┃           ┃           ┃           ┃   ┃   VOL-    ┃   VOL+    ┃   LAST    ┃   NEXT    ┃     \     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    GIF    ┃    ADJ    ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                    &kp LC(NUMBER_6)  &kp LC(PAGE_UP)           &kp LC(PAGE_DOWN)        &hm LEFT_WIN LG(D)            &kp LA(LG(PRINTSCREEN))    &kp PRINTSCREEN  &hm RIGHT_WIN F7  &kp F8            &kp F9        &kp F12
                    &kp LC(W)         &kp LG(LC(LEFT_ARROW))    &kp LC(LG(DOWN))         &hm LEFT_SHIFT LC(LG(RIGHT))  &kp PG_UP                  &kp HOME         &hm RSHIFT F4     &kp F5            &kp F6        &kp F11
&kp LS(LC(ESCAPE))  &kp LC(LS(T))     &hm LCTRL LS(LA(ESCAPE))  &hm LEFT_ALT LC(LG(F4))  &kp LA(ESCAPE)                &kp PAGE_DOWN              &kp END          &kp F1            &hm RIGHT_ALT F2  &hm RCTRL F3  &kp F10  &kp LS(LC(F4))
                                                                &kp C_VOLUME_DOWN        &kp C_VOLUME_UP               &none                      &kp LS(LC(F1))   &kp LS(LC(F2))    &kp LS(LC(F3))
            >;
        };

        L4-punc {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "L4-punc";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃   RESET   ┃ BT CLEAR  ┃  OUT TOG  ┃           ┃           ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ BOOTLOAD  ┃ BT NEXT   ┃           ┃           ┃           ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃ BT PREV   ┃           ┃           ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                &kp CARET       &kp DOUBLE_QUOTES    &kp EXCLAMATION       &hm LEFT_WIN LA(LC(NUMBER_8))  &kp LA(LC(NUMBER_9))    &kp LS(PRINTSCREEN)  &hm RIGHT_WIN LEFT_BRACKET       &kp HASH                  &kp RIGHT_BRACKET       &key_repeat
                &kp PIPE        &kp UNDERSCORE       &kp SEMICOLON         &hm LEFT_SHIFT SLASH           &kp AT_SIGN             &kp LEFT_BRACE       &hm LEFT_SHIFT LEFT_PARENTHESIS  &kp ASTERISK              &kp RIGHT_PARENTHESIS   &kp DOLLAR
&kp LS(LA(F1))  &kp LS(LA(F2))  &hm LCTRL AMPERSAND  &hm LEFT_ALT PERCENT  &kp NON_US_BACKSLASH           &kp GRAVE               &kp RIGHT_BRACE      &kp LESS_THAN                    &hm RIGHT_ALT LA(LC(F5))  &hm RCTRL GREATER_THAN  &kp TILDE    &kp LS(LA(F6))
                                                     &kp LS(LA(F3))        &kp MINUS                      &kp COLON               &none                &kp LS(LA(F4))                   &kp LS(LA(F5))
            >;
        };

        L5-sa-reverse {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "L5-sa";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃ NEXT FILE ┃ MARK IN   ┃ ROTATE    ┃ MARK OUT  ┃ SHOW SNAP ┃   ┃           ┃           ┃           ┃           ┃           ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ TVP II    ┃ LEFT      ┃ PAN       ┃ RIGHT     ┃ PLAY/FLIP ┃   ┃           ┃           ┃           ┃           ┃           ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃ FULLSCR   ┃ SHIFT     ┃ COPY      ┃ DELETE    ┃ PASTE     ┃ IMG MARK  ┃   ┃           ┃           ┃           ┃           ┃           ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃ UNDO/SAVE ┃  SEL/MOV  ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                      &kp LS(LA(Z))  &kp LS(LA(F))        &kp LS(LA(R))           &hm LEFT_WIN LS(LA(C))    &kp LS(LA(G))           &kp LS(LA(QUESTION))  &hm RIGHT_WIN LS(LA(U))       &kp LA(LG(UP_ARROW))         &kp LS(F10)          &kt LEFT_ALT
                      &kp LS(LA(B))  &kp LS(LA(N))        &kp LS(LA(S))           &hm LEFT_SHIFT LS(LA(T))  &kp LS(LA(D))           &kp LS(LA(PERIOD))    &hm RIGHT_SHIFT LA(LG(LEFT))  &kp LA(LG(DOWN))             &kp LA(LG(RIGHT))    &kp LS(LA(Y))
&kp LS(LA(NUMBER_1))  &kp LS(LA(V))  &hm LCTRL LS(LA(P))  &hm LEFT_ALT LS(LA(L))  &kp LS(LA(M))             &kp CAPS                &kp LS(LA(SQT))       &mkp LCLK                     &hm RIGHT_ALT LS(LA(COMMA))  &hm RCTRL LS(LA(X))  &kp LS(LA(J))  &kp LS(LA(N7))
                                                          &kp LS(LA(NUMBER_2))    &kp LS(LA(NUMBER_3))      &kp LS(LA(NUMBER_4))    &kp LS(LA(N5))        &none                         &kp LS(LA(NUMBER_6))
            >;
        };

